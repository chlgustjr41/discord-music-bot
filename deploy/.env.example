# ── Discord ──────────────────────────────────────────────────────────────
# Bot token: Discord Developer Portal → your app → Bot → Token
DISCORD_TOKEN=changeme

# Discord webhook URL for guardian alerts (Server Settings → Integrations →
# Webhooks → New Webhook in your admin channel)
ALERT_WEBHOOK_URL=changeme

# ── Firebase / web app ───────────────────────────────────────────────────
# Host path to the Firebase service-account JSON (Firebase console →
# Project settings → Service accounts → Generate new private key).
# Mounted read-only into the bot container.
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# Public URL of the web dashboard (used in session embeds).
WEB_APP_URL=https://jacky-music.web.app

# ── Lavalink ─────────────────────────────────────────────────────────────
# Shared secret between bot/guardian and Lavalink. Generate: openssl rand -hex 16
LAVALINK_PASSWORD=changeme

# JVM heap. 512m fits the 2GB VM budget (see spec §2 constraints).
LAVALINK_HEAP=512m

# ── YouTube source ───────────────────────────────────────────────────────
# THE ONLY PLACE the youtube-source plugin version is declared (spec §3.2).
# Latest releases: https://github.com/lavalink-devs/youtube-source/releases
# Accepts either a release tag (1.18.1) or a full 40-char master commit hash
# (snapshot build from https://maven.lavalink.dev/snapshots) for when YouTube
# breaks the newest release before upstream cuts a new one (playbook F3).
YOUTUBE_PLUGIN_VERSION=33d100ba10c9fb9242a150d1bac70ab5826335d5

# OAuth refresh token (playbook F2). Obtain/rotate: make reauth (drives legacy stack until M2 — see RUNBOOK F2 caveat)
# May be empty; poToken layer (M2) carries playback without it.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Shared secret between Lavalink and the yt-cipher sidecar (remote signature
# deciphering — playbook F3 escalation when no plugin release/snapshot works).
# Generate: openssl rand -hex 16
YOUTUBE_REMOTE_CIPHER_PASSWORD=changeme

# Where Lavalink sends decipher requests. Default is the self-hosted sidecar;
# can be flipped to the public https://cipher.kikkia.dev/ in an emergency
# (rate-limited, no uptime guarantee).
#YOUTUBE_REMOTE_CIPHER_URL=http://cipher:8001

# How often the token-minter refreshes the poToken (hours).
# Must stay below bgutil's 6h TOKEN_TTL so a fresh token lands before the old expires.
POT_REFRESH_HOURS=5.5

# --- Voice control (optional; entire feature off unless BOTH set) ----------
# Start the listener with: COMPOSE_PROFILES=voice docker compose up -d
VOICE_CONTROL_ENABLED=false
# Second Discord application token for "Jacky Ears" (Developer Portal; needs
# Connect/Speak perms + voice states intent; invite it to your servers).
DISCORD_EARS_TOKEN=
# Shared secret for bot <-> listener HTTP on the internal network.
VOICE_INTERNAL_TOKEN=
