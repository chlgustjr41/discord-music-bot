# Discord
DISCORD_TOKEN=your_discord_bot_token

# Firebase (bot uses service account)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/serviceAccountKey.json

# Spotify (disabled — requires Premium developer account)
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Lavalink
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# YouTube OAuth — required for reliable playback on cloud-hosted Lavalink
# (GCP/AWS/etc.) where YouTube blocks unauthenticated requests from datacenter IPs.
#
# Setup (one-time):
#   1. Leave this blank, start Lavalink (`docker compose up -d lavalink`)
#   2. Tail the logs (`docker logs -f jacky-lavalink`) for a line like:
#        "OAUTH INTEGRATION: To give youtube-source access to your account,
#         go to https://www.google.com/device and enter code XXXX-XXXX"
#   3. Open the URL in a browser, sign in with a Google account
#   4. The logs will then print: "Refresh token: ya29...."
#   5. Paste that token here and restart Lavalink
#      (`docker compose up -d --force-recreate lavalink`)
YOUTUBE_OAUTH_REFRESH_TOKEN=

# YouTube Data API (for Cloud Function)
YOUTUBE_API_KEY=your_youtube_api_key

# Web App URL (for session code links)
WEB_APP_URL=http://localhost:5173
