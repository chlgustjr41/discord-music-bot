rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Session codes — anyone with the code can read
    match /sessionCodes/{code} {
      allow read: if true;
      allow write: if false;  // Only bot (admin SDK) writes
    }

    // Server state — anyone with access to the session can read and write
    match /servers/{serverId} {
      allow read, write: if true;

      // Subcollections: history (open writes — used by bot via admin SDK and web client)
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }

      // Playlists — split create/update/delete so the rule layer can be tightened later.
      // Today both create and update are allowed; client-side getDoc + writeBatch is the
      // primary defense against name collisions. Delete is allowed for owner-initiated
      // remove and rename batches.
      match /playlists/{name} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }
    }

    // Server owners — authenticated users can read/write their own
    match /serverOwners/{serverId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-user pinned servers ("My Servers" beyond ownership): only the
    // user themselves can read or write their pins.
    match /users/{uid}/pinnedServers/{serverId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ephemeral dashboard presence and cursors. Deliberately NOT under
    // /servers, whose subcollection rule is `allow read, write: if true` —
    // rules are OR'd across matches, so anything placed there could never
    // restrict access no matter how it was written. Read requires auth so
    // anonymous visitors cannot enumerate who is in a session; write is
    // uid-scoped so nobody can move someone else's cursor or impersonate
    // them. This is the one place in this app where per-user write rules are
    // both meaningful and achievable.
    // `updatedAt` is stamped by the server, never by the writer: a client-set
    // timestamp lets anyone write one far-future value and stay in everyone's
    // presence bar forever, and nobody else could delete them because writes
    // are uid-scoped. Clock skew alone would also make honest users flicker
    // in and out.
    //
    // The shape is constrained as well as the author. Without that, `name` and
    // `color` are free text (an avatar and cursor pill visually identical to
    // somebody else's) and `photoURL` is worse: it is rendered as an <img src>
    // for every viewer, so an attacker-controlled URL harvests the IP and
    // User-Agent of everyone on the dashboard on every render, with no
    // interaction. Name collision is only BOUNDED here, not eliminated — two
    // people can legitimately share a display name — which is acceptable
    // because every participant is an authenticated member of a session whose
    // code they already have.
    match /presence/{sessionCode}/participants/{uid} {
      function validPhoto(photo) {
        return photo == null
          || (photo is string
              && photo.size() < 512
              // matches() is a full-string match: an https URL whose host is a
              // googleusercontent.com subdomain, the Google account photo host.
              && photo.matches('https://[a-zA-Z0-9-]+[.]googleusercontent[.]com/.*'));
      }
      function validCursor(cursor) {
        return cursor == null
          || (cursor.keys().hasOnly(['x', 'y'])
              && cursor.keys().hasAll(['x', 'y'])
              && cursor.x is number
              && cursor.y is number);
      }

      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['name', 'photoURL', 'color', 'cursor', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'color', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 64
        && request.resource.data.color is string
        && request.resource.data.color.size() <= 32
        && validPhoto(request.resource.data.get('photoURL', null))
        && validCursor(request.resource.data.get('cursor', null))
        && request.resource.data.updatedAt == request.time;
    }

    // Collective view state: which panels are open and what is in the shared
    // text fields. Deliberately NOT uid-scoped — this is a shared control
    // surface, like the queue, so any participant of THAT session may write it
    // (see inSession below — collective is not the same as unrestricted).
    // The shape is still constrained, and updatedAt is server-stamped for the
    // same reason as presence: a client-set timestamp cannot be trusted.
    //
    // The path alternates collection/document exactly as the participants rule
    // does — presence (collection) / {sessionCode} (document) / shared
    // (collection) / view (document) — so it is a sibling of that rule and not
    // captured by it: `participants` there is a literal segment and cannot
    // match `shared`. Rules are OR'd across matches, so the catch-all deny
    // below does not shadow this either.
    match /presence/{sessionCode}/shared/view {
      // Both maps are optional: every write is a nested merge, so the first
      // one to land carries only `sections` or only `inputs`.
      function sections() { return request.resource.data.get('sections', {}); }
      function inputs() { return request.resource.data.get('inputs', {}); }

      // Panel ids are open-ended (a new panel is one line in a component), so
      // only the count is bounded. The values are booleans consumed through
      // mergeSections, which drops anything that is not one.
      function validSections() {
        return sections().size() <= 20;
      }

      function validEntry(entry) {
        return entry.keys().hasOnly(['value', 'by'])
          && entry.keys().hasAll(['value', 'by'])
          && entry.value is string
          // Matches MAX_INPUT_LEN in lib/sharedView.ts, which slices to exactly
          // that length — so this is <=, not <, or every full-length write from
          // an honest client would be rejected.
          && entry.value.size() <= 200
          && entry.by is string
          && entry.by.size() <= 128
          // `by` must be YOUR uid, not merely a uid. typistLabel resolves it
          // straight into a display name and that person's presence colour —
          // the one thing tying a face in the avatar bar to a cursor on
          // screen — so an unbound `by` lets anyone put someone else's name
          // and colour on text they never typed. The victim is the one person
          // who would not see it: shouldAdoptInput ignores an entry whose
          // `by` is your own uid. This document is not uid-scoped (it is
          // collective state) but authorship within it still is; the two are
          // separable and only the first was intended.
          && entry.by == request.auth.uid;
      }

      // Rules cannot iterate a map, so every shared input id is named here and
      // validated individually. That is a deliberate trade: adding a shared
      // field costs a rules deploy, and in exchange there is no id for which
      // `value` is unbounded free text that every viewer's browser renders.
      // The count cap is kept as well, as the statement of intent.
      function validInputs() {
        return inputs().size() <= 10
          && inputs().keys().hasOnly(['search'])
          && validEntry(inputs().get('search', {'value': '', 'by': ''}));
      }

      // Not uid-scoped, but participant-scoped: you must be IN the session to
      // drive its panels. Without this, any signed-in account that learns or
      // guesses a session code can rewrite this document in a loop —
      // force-collapsing every panel on every dashboard and blanking the
      // shared search box — and the 300 ms throttle that would normally
      // bound it lives entirely in the client. Victims have no in-app remedy:
      // they cannot revoke a writer, so the only escape is the solo toggle.
      // "Not uid-scoped" was the decision; "not participant-scoped" came
      // along with it unintentionally.
      //
      // Costs one document read per write. The client publishes its presence
      // document on entering shared mode, before any panel can be clicked, so
      // an honest participant always satisfies this.
      function inSession() {
        return exists(
          /databases/$(database)/documents/presence/$(sessionCode)/participants/$(request.auth.uid)
        );
      }

      allow read: if request.auth != null;
      // create and update, not `write`: on a delete `request.resource.data` is
      // null and `.keys()` errors out. That denies the delete either way, but
      // for the wrong reason and with a misleading error.
      allow create, update: if request.auth != null
        && inSession()
        && request.resource.data.keys().hasOnly(['sections', 'inputs', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validSections()
        && validInputs();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
