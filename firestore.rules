rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Session codes — anyone with the code can read
    match /sessionCodes/{code} {
      allow read: if true;
      allow write: if false;  // Only bot (admin SDK) writes
    }

    // Server state — anyone with access to the session can read and write
    match /servers/{serverId} {
      allow read, write: if true;

      // Subcollections: history (open writes — used by bot via admin SDK and web client)
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }

      // Playlists — split create/update/delete so the rule layer can be tightened later.
      // Today both create and update are allowed; client-side getDoc + writeBatch is the
      // primary defense against name collisions. Delete is allowed for owner-initiated
      // remove and rename batches.
      match /playlists/{name} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }
    }

    // Server owners — authenticated users can read/write their own
    match /serverOwners/{serverId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-user pinned servers ("My Servers" beyond ownership): only the
    // user themselves can read or write their pins.
    match /users/{uid}/pinnedServers/{serverId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ephemeral dashboard presence: who is looking at this session right now.
    // Deliberately NOT under /servers, whose subcollection rule is
    // `allow read, write: if true` — rules are OR'd across matches, so
    // anything placed there could never restrict access no matter how it was
    // written.
    //
    // READ IS PUBLIC, deliberately. The session code is already the capability
    // for everything else on this dashboard — queue, playback, history — so
    // who is looking is no more sensitive than what is playing, and a
    // signed-out visitor is meant to see the avatar row.
    //
    // WRITE SPLITS ON THE DOCUMENT ID, because presence is now a property of
    // having the page open rather than of having an account, and an anonymous
    // row cannot be uid-scoped — there is no uid to scope it to.
    //
    //   id == request.auth.uid   → signed in: only you can create, refresh or
    //                              remove you, exactly as before.
    //   id matches anon_<id>     → anonymous: writable and deletable WITHOUT
    //                              AUTH, which means by ANYONE who has the
    //                              session code.
    //
    // State that consequence plainly rather than hiding it: a griefer with the
    // code can overwrite or delete any anonymous presence row, blanking
    // someone's avatar or adding fake ones. It is accepted because it is the
    // trust level this app already runs at — `servers/{id}` and every
    // subcollection under it are `allow read, write: if true`, so the queue,
    // playback and history are already fully open to the same person, and a
    // presence row is strictly less valuable than the queue. A deleted row
    // also comes back on the next heartbeat, within 15 seconds. Signed-in rows
    // keep their uid scoping, so an account's avatar still cannot be forged or
    // removed by anyone else.
    //
    // `updatedAt` is stamped by the server, never by the writer: a client-set
    // timestamp lets anyone write one far-future value and stay in everyone's
    // presence bar forever, and nobody else could delete them because writes
    // are uid-scoped. Clock skew alone would also make honest users flicker
    // in and out.
    //
    // The shape is constrained as well as the author — see validShape below.
    match /presence/{sessionCode}/participants/{pid} {
      function validPhoto(photo) {
        return photo == null
          || (photo is string
              && photo.size() < 512
              // matches() is a full-string match: an https URL whose host is a
              // googleusercontent.com subdomain, the Google account photo host.
              && photo.matches('https://[a-zA-Z0-9-]+[.]googleusercontent[.]com/.*'));
      }
      // Must stay identical to ANON_ID in frontend/src/lib/presence.ts, which
      // is what decides who is DISPLAYED as anonymous. matches() is a
      // full-string match, so a uid can never satisfy this by prefix. The
      // alphabet covers a crypto.randomUUID(), hyphens included.
      function isAnon() {
        return pid.matches('anon_[A-Za-z0-9_-]{8,64}');
      }
      // The shape, which is identical on both branches. Without it `name` and
      // `color` are free text (an avatar visually identical to somebody
      // else's) and `photoURL` is worse: it is rendered as an <img src> for
      // every viewer, so an attacker-controlled URL harvests the IP and
      // User-Agent of everyone on the dashboard on every render, with no
      // interaction. Name collision is only BOUNDED here, not eliminated —
      // two people can legitimately share a display name.
      //
      // `anon` is optional rather than required: signed-in clients do not send
      // it, and demanding it would deny every write from a browser still
      // running the previous build.
      function validShape() {
        return request.resource.data.keys().hasOnly(
                 ['name', 'photoURL', 'color', 'focused', 'anon', 'updatedAt'])
          && request.resource.data.keys().hasAll(
               ['name', 'color', 'focused', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 64
          && request.resource.data.color is string
          && request.resource.data.color.size() <= 32
          // Greys the avatar for everyone else: visible tab AND focused window.
          && request.resource.data.focused is bool
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if true;
      allow delete: if (request.auth != null && request.auth.uid == pid)
        || isAnon();
      allow create, update: if
        (request.auth != null
          && request.auth.uid == pid
          && validShape()
          && validPhoto(request.resource.data.get('photoURL', null)))
        // An anonymous row may not carry a photo AT ALL. There is no account
        // photo behind it, so any URL there was chosen by the writer — and
        // this branch has no authenticated writer to hold responsible.
        || (isAnon()
            && validShape()
            && request.resource.data.get('photoURL', null) == null);
    }


    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
