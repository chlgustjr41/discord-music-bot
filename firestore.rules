rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Session codes — anyone with the code can read
    match /sessionCodes/{code} {
      allow read: if true;
      allow write: if false;  // Only bot (admin SDK) writes
    }

    // Server state — anyone with access to the session can read and write
    match /servers/{serverId} {
      allow read, write: if true;

      // Subcollections: history (open writes — used by bot via admin SDK and web client)
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }

      // Playlists — split create/update/delete so the rule layer can be tightened later.
      // Today both create and update are allowed; client-side getDoc + writeBatch is the
      // primary defense against name collisions. Delete is allowed for owner-initiated
      // remove and rename batches.
      match /playlists/{name} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }
    }

    // Server owners — authenticated users can read/write their own
    match /serverOwners/{serverId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Per-user pinned servers ("My Servers" beyond ownership): only the
    // user themselves can read or write their pins.
    match /users/{uid}/pinnedServers/{serverId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ephemeral dashboard presence and cursors. Deliberately NOT under
    // /servers, whose subcollection rule is `allow read, write: if true` —
    // rules are OR'd across matches, so anything placed there could never
    // restrict access no matter how it was written. Read requires auth so
    // anonymous visitors cannot enumerate who is in a session; write is
    // uid-scoped so nobody can move someone else's cursor or impersonate
    // them. This is the one place in this app where per-user write rules are
    // both meaningful and achievable.
    // `updatedAt` is stamped by the server, never by the writer: a client-set
    // timestamp lets anyone write one far-future value and stay in everyone's
    // presence bar forever, and nobody else could delete them because writes
    // are uid-scoped. Clock skew alone would also make honest users flicker
    // in and out.
    match /presence/{sessionCode}/participants/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.updatedAt == request.time;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
