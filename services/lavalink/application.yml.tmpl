server:
  port: 2333
  address: 0.0.0.0

lavalink:
  # PLUGIN_BLOCK_START
  plugins:
    - dependency: "dev.lavalink.youtube:youtube-plugin:__YOUTUBE_PLUGIN_VERSION__"
      repository: "__YOUTUBE_PLUGIN_REPOSITORY__"
      snapshot: __YOUTUBE_PLUGIN_SNAPSHOT__
  # PLUGIN_BLOCK_END
  server:
    password: "${LAVALINK_SERVER_PASSWORD}"
    # Only YouTube (via the plugin) and SoundCloud are served; every other
    # built-in source is switched off EXPLICITLY, because upstream defaults
    # most of them to on.
    # The generic http source is the dangerous one: it lets anyone who can
    # queue a track make this server fetch an arbitrary URL — reaching hosts
    # on the LAN it sits in, and disclosing the home IP to whatever server the
    # URL points at.
    # The bot's URL allowlist in services/bot/src/jacky/audio/models.py must
    # stay in step with this list.
    sources:
      youtube: false  # handled by youtube-plugin above
      soundcloud: true
      http: false
      local: false
      bandcamp: false
      twitch: false
      vimeo: false
      nico: false
    # Send-queue length: higher rides out longer stalls (GC, a busy host) at
    # the cost of slower pause/skip response. Upstream default 400.
    bufferDurationMs: ${LAVALINK_BUFFER_MS:400}
    # Frame buffer: decoded audio held ahead of playback. Upstream default 5000.
    frameBufferDurationMs: ${LAVALINK_FRAME_BUFFER_MS:5000}

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true
    # Client order matters: Lavalink tries top-to-bottom until one resolves.
    # MUSIC: search-only. TVHTML5_SIMPLY first for playback: TV-class IP
    # reputation survives datacenter IPs. TV last: carries OAuth for
    # sign-in-gated streams (metadata support: none, useless alone).
    clients:
      - MUSIC
      - TVHTML5_SIMPLY
      - WEB
      - WEBEMBEDDED
      - ANDROID_VR
      - TV
    clientOptions:
      MUSIC:
        playback: false
        videoLoading: false
    oauth:
      enabled: true
      refreshToken: "${YOUTUBE_OAUTH_REFRESH_TOKEN:}"
      skipInitialization: false
    # Offloads signature/n-function extraction to the yt-cipher sidecar
    # (compose service `cipher`), which runs the real player JS — survives
    # YouTube player rollouts that break LocalSignatureCipherManager
    # ("Must find n function", 2026-07-10 outage).
    remoteCipher:
      url: "${YOUTUBE_REMOTE_CIPHER_URL:}"
      password: "${YOUTUBE_REMOTE_CIPHER_PASSWORD:}"
      userAgent: "jacky-music"
    # POT_BLOCK_START (rendered from /data/tokens/tokens.env at container start)
    pot:
      token: "__POT_TOKEN__"
      visitorData: "__POT_VISITOR_DATA__"
    # POT_BLOCK_END

logging:
  # Off: Lavalink's default request log prints full request payloads, and
  # those carry poTokens (the minter's POST /youtube) and Discord voice
  # session tokens (the bot's player updates) straight into the logs.
  request:
    enabled: false
  level:
    root: INFO
    lavalink: INFO
    # INFO required so the reauth flow (playbook F2) can scrape the device
    # code and refresh token from the logs.
    dev.lavalink.youtube.http.YoutubeOauth2Handler: INFO
